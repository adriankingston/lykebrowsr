# Copy this file to `.env`.
#
# MusicBrainz asks that API clients identify themselves with contact info in
# the User-Agent (https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting).
# An email address or project URL is fine. No API key is needed.
MB_CONTACT=

# Optional: a Discogs personal access token (discogs.com → Settings →
# Developers). Not required — artist profiles work without it — but a token
# raises the rate limit and unlocks artist photos on artist pages.
DISCOGS_TOKEN=

PORT=4800

# No YouTube cookie is stored any more. The extractor reads them live from
# your running Chrome each time (chrome-cookies.js) — a saved copy went stale
# and got the whole Google session revoked, twice.
#
# One-time setup: run this in Terminal and click "Always Allow" on the dialog:
#   security find-generic-password -w -s "Chrome Safe Storage" -a Chrome

# Optional: a Last.fm API key (last.fm/api/account/create) — fourth tier of
# the genre backfill for artists MusicBrainz/Wikidata/Discogs can't cover.
LASTFM_API_KEY=
