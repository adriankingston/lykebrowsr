# Copy this file to `.env`.
#
# MusicBrainz asks that API clients identify themselves with contact info in
# the User-Agent (https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting).
# An email address or project URL is fine. No API key is needed.
MB_CONTACT=

# Optional: a Discogs personal access token (discogs.com → Settings →
# Developers). Not required — artist profiles work without it — but a token
# raises the rate limit and unlocks artist photos on artist pages.
DISCOGS_TOKEN=

PORT=4800

# Optional: your YouTube Music cookies, so `npm run extract` can pull the
# Liked Music playlist without a browser.
#
# Take them from an INCOGNITO window: Google rotates the cookies of a session
# you keep browsing in, which invalidates any copy within a day or so. Cookies
# from a private window you then close (without signing out) keep working.
#   1. Incognito window (⇧⌘N), sign in at https://music.youtube.com
#   2. DevTools → Network → filter "browse" → open the playlist / scroll.
#   3. Right-click a /youtubei/v1/browse row → Copy → Copy as cURL.
#   4. pbpaste | node extract-yt-likes.js --save-cookie
#   5. Close the incognito window WITHOUT signing out.
# This authenticates as your Google account — treat it like a password. It
# never leaves your machine (.env is gitignored) and is only sent to YouTube.
YT_COOKIE=

# Optional: a Last.fm API key (last.fm/api/account/create) — fourth tier of
# the genre backfill for artists MusicBrainz/Wikidata/Discogs can't cover.
LASTFM_API_KEY=
